{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=moviehub.db;Default Timeout=30"
  },

  "Tmdb": {
    "ApiKey": "YOUR_TMDB_API_KEY_OR_READ_ACCESS_TOKEN",
    "Language": "en-US",
    "MaxConcurrency": 3
  },

  "Omdb": {
    "ApiKey": ""
  },

  "Crawler": {
    "DefaultCooldownHours": 12,
    "MaxConcurrentScans": 2,
    "MaxConcurrentFolderTasks": 3,
    "RequestTimeoutSeconds": 30,
    "MaxRecursionDepth": 6,
    "FailureBackoffMinutes": 60,
    "PreferFolderPoster": true
  },

  "Media": {
    "FfprobePath": "ffprobe",
    "FfmpegPath": "",
    "ProbeTimeoutSeconds": 90,
    "MaxConcurrentProbes": 2,
    "MaxRemuxSessions": 2
  },

  "Admin": {
    "Username": "admin",
    "PasswordHash": "",
    "Password": "",
    "SessionHours": 8
  },

  "Seed": {
    "Sources": [
      {
        "Name": "Server 1 - English Movies (1080p)",
        "CategorySlug": "english",
        "RootUrl": "http://172.16.50.7/DHAKA-FLIX-14/English%20Movies%20(1080p)/",
        "Strategy": "YearBased",
        "CooldownHours": 12,
        "IncludedFolders": "",
        "ExcludedFolders": "",
        "Enabled": true
      },
      {
        "Name": "Server 2 - English Movies",
        "CategorySlug": "english",
        "RootUrl": "http://172.16.50.7/DHAKA-FLIX-7/English%20Movies/",
        "Strategy": "Auto",
        "CooldownHours": 12,
        "IncludedFolders": "",
        "ExcludedFolders": "",
        "Enabled": true
      }
    ]
  }
}
