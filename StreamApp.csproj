<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamApp</RootNamespace>
    <AssemblyName>StreamApp</AssemblyName>
    <UserSecretsId>streamapp-7f3c1b52</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Never compile generated files from any obj/bin folder (also nested ones left behind by extracting a zip inside the project). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The project's own ffmpeg/ffprobe live in .\tools; carry them into the publish output (dotnet run uses the project folder directly) so the project folder is self-contained. -->
  <ItemGroup>
    <None Include="tools\**\*" Exclude="tools\README.txt" CopyToPublishDirectory="PreserveNewest" LinkBase="tools" />
    <None Include="tools\README.txt" CopyToPublishDirectory="PreserveNewest" LinkBase="tools" />
  </ItemGroup>

</Project>
