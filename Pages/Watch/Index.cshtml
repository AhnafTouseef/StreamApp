@page "/watch/{id:int}"
@model MovieHub.Pages.Watch.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Watch " + Model.Movie.Title;
    var m = Model.Movie;
    var f = Model.Current;
}
<div class="watch-page">
    @if (f == null)
    {
        <partial name="_EmptyState" model="@("Nothing to play", "No video file is recorded for this entry. An administrator can re-scan its source.")" />
        <p style="text-align:center"><a class="btn btn-ghost" href="/movie/@m.Id">Back to details</a></p>
    }
    else
    {
        <div class="player" id="player" tabindex="0" aria-label="Video player">
            <video id="video" preload="metadata" playsinline></video>
            <div class="player-overlay"><div class="player-spinner"></div></div>
            <div class="player-message" id="player-message" role="alert"><div><h2 id="msg-title">Playback problem</h2><p id="msg-text"></p><button class="btn btn-primary btn-sm" id="msg-retry" type="button">Try again</button></div></div>
            <div class="controls" id="controls">
                <div class="seek"><div class="buffered" id="buffered"></div><input type="range" id="seek" min="0" max="1000" value="0" step="1" aria-label="Seek" /></div>
                <div class="ctrl-row">
                    <button class="ctrl-btn" id="play" type="button" aria-label="Play">▶</button>
                    <button class="ctrl-btn" id="mute" type="button" aria-label="Mute">🔊</button>
                    <input type="range" id="volume" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
                    <span class="time"><span id="t-cur">0:00</span> / <span id="t-dur">0:00</span></span>
                    <span class="spacer"></span>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-sub" type="button" aria-label="Subtitles">CC</button><div class="menu" id="menu-sub"></div></div>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-audio" type="button" aria-label="Audio track">🎧</button><div class="menu" id="menu-audio"></div></div>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-speed" type="button" aria-label="Playback speed">1×</button><div class="menu" id="menu-speed"></div></div>
                    <button class="ctrl-btn" id="fs" type="button" aria-label="Fullscreen">⛶</button>
                </div>
            </div>
        </div>

        <div class="watch-info">
            <h1>@m.Title @(m.ReleaseYear.HasValue ? $"({m.ReleaseYear})" : "")</h1>
            <div class="muted" id="stream-status">Streaming directly from the source server.</div>
            <div class="muted">@f.FileName</div>
            @if (m.MediaFiles.Count > 1)
            {
                <div class="picker" aria-label="Choose file">
                    @foreach (var x in m.MediaFiles.OrderBy(x => x.FileName))
                    {
                        <a class="@(x.Id == f.Id ? "is-active" : "")" href="/watch/@m.Id?file=@x.Id">@x.FileName</a>
                    }
                </div>
            }
            <p><a href="/movie/@m.Id">← Back to details</a></p>
        </div>
        <script type="application/json" id="player-config">@Html.Raw(Model.ConfigJson)</script>
    }
</div>

@section Scripts {
    @if (f != null) { <script src="~/js/player.js" asp-append-version="true"></script> }
}
