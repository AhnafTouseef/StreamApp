@page "/watch/{id:int}"
@model MovieHub.Pages.Watch.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Watch " + Model.Movie.Title;
    var m = Model.Movie;
    var f = Model.Current;
}
<div class="watch-page">
    @if (f == null)
    {
        <partial name="_EmptyState" model="@("Nothing to play", "No video file is recorded for this entry. An administrator can re-scan its source.")" />
        <p style="text-align:center"><a class="btn btn-ghost" href="/movie/@m.Id">Back to details</a></p>
    }
    else
    {
        <div class="player" id="player" tabindex="0" aria-label="Video player">
            <video id="video" preload="metadata" playsinline></video>
            <div class="subs" id="subs" aria-live="off"></div>
            <div class="player-overlay"><div class="player-spinner"></div></div>
            <div class="drop-hint" aria-hidden="true"><div><strong>Drop subtitle file</strong><span>.srt · .vtt · .ass · .ssa</span></div></div>
            <div class="seek-flash seek-back" id="flash-back" aria-hidden="true"><span>⏪</span><b>10 s</b></div>
            <div class="seek-flash seek-fwd" id="flash-fwd" aria-hidden="true"><span>⏩</span><b>10 s</b></div>
            <div class="hold-badge" id="hold-badge" aria-hidden="true">2× ▶▶</div>
            <div class="player-toast" id="player-toast" role="status"></div>
            <div class="player-message" id="player-message" role="alert"><div><h2 id="msg-title">Playback problem</h2><p id="msg-text"></p><button class="btn btn-primary btn-sm" id="msg-retry" type="button">Try again</button></div></div>

            <div class="tuner" id="tuner" hidden>
                <div class="tuner-head"><strong>Subtitle timing</strong><button type="button" class="tuner-x" id="tuner-close" aria-label="Close timing panel">✕</button></div>
                <div class="tuner-track" id="tuner-track">No subtitle selected</div>
                <div class="tuner-read"><output id="tuner-offset">0.00 s</output></div>
                <div class="tuner-steps">
                    <button type="button" data-step="-1">−1 s</button>
                    <button type="button" data-step="-0.1">−0.1</button>
                    <button type="button" data-step="0.1">+0.1</button>
                    <button type="button" data-step="1">+1 s</button>
                </div>
                <input type="range" id="tuner-slider" min="-60" max="60" step="0.05" value="0" aria-label="Subtitle offset in seconds" />
                <p class="tuner-help">Minus shows subtitles earlier, plus shows them later. Keys: <kbd>G</kbd> earlier, <kbd>H</kbd> later.</p>
                <button type="button" class="tuner-sync" id="tuner-sync">Sync: the closest line starts right now</button>
                <p class="tuner-help">Pause exactly when you hear a line begin, then press Sync.</p>
                <label class="tuner-row">Frame-rate fix
                    <select id="tuner-scale" aria-label="Subtitle frame-rate correction">
                        <option value="1">None</option>
                        <option value="0.959040959">23.976 → 25 fps</option>
                        <option value="1.04270937">25 → 23.976 fps</option>
                        <option value="0.96">24 → 25 fps</option>
                        <option value="1.041666667">25 → 24 fps</option>
                        <option value="0.999000999">23.976 → 24 fps</option>
                        <option value="1.001">24 → 23.976 fps</option>
                    </select>
                </label>
                <p class="tuner-help">Use when the subtitle starts in sync but drifts further out of sync as the movie goes on.</p>
                <div class="tuner-row">Size
                    <span class="tuner-size"><button type="button" id="size-down" aria-label="Smaller subtitles">A−</button><output id="size-read">100%</output><button type="button" id="size-up" aria-label="Larger subtitles">A+</button></span>
                </div>
                <button type="button" class="tuner-reset" id="tuner-reset">Reset timing</button>
            </div>

            <div class="controls" id="controls">
                <div class="seek"><div class="buffered" id="buffered"></div><input type="range" id="seek" min="0" max="1000" value="0" step="1" aria-label="Seek" /></div>
                <div class="ctrl-row">
                    <button class="ctrl-btn" id="play" type="button" aria-label="Play">▶</button>
                    <button class="ctrl-btn" id="mute" type="button" aria-label="Mute">🔊</button>
                    <input type="range" id="volume" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
                    <span class="time"><span id="t-cur">0:00</span> / <span id="t-dur">0:00</span></span>
                    <span class="spacer"></span>
                    <button class="ctrl-btn ctrl-compat" id="btn-compat" type="button" aria-pressed="false" aria-label="Compatibility mode" title="Compatibility mode: the server converts the video with ffmpeg">Compat</button>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-sub" type="button" aria-label="Subtitles" title="Subtitles (C)">CC</button><div class="menu" id="menu-sub"></div></div>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-audio" type="button" aria-label="Audio track" title="Audio track">🎧</button><div class="menu" id="menu-audio"></div></div>
                    <div class="menu-wrap"><button class="ctrl-btn" id="btn-speed" type="button" aria-label="Playback speed" title="Playback speed ( &lt; and &gt; )">1×</button><div class="menu menu-speed" id="menu-speed"></div></div>
                    <button class="ctrl-btn" id="fs" type="button" aria-label="Fullscreen">⛶</button>
                </div>
            </div>
            <input type="file" id="sub-file" accept=".srt,.vtt,.ass,.ssa" hidden />
        </div>

        <div class="watch-info">
            <h1>@m.Title @(m.ReleaseYear.HasValue ? $"({m.ReleaseYear})" : "")</h1>
            <div class="muted" id="stream-status">Streaming directly from the source server.</div>
            <div class="compat-row">
                <label class="compat-switch" for="compat-switch">
                    <input type="checkbox" id="compat-switch" role="switch" />
                    <span class="compat-track" aria-hidden="true"></span>
                    <span class="compat-label">Compatibility mode: <b id="compat-state">Off</b></span>
                </label>
                <span class="muted small" id="compat-hint"></span>
            </div>
            <div class="muted">@f.FileName</div>
            <div class="muted small" id="sub-tip" hidden>No subtitles found for this movie: drag a subtitle file (.srt, .vtt, .ass) onto the video to use one.</div>
            @if (m.MediaFiles.Count > 1)
            {
                <div class="picker" aria-label="Choose file">
                    @foreach (var x in m.MediaFiles.OrderBy(x => x.FileName))
                    {
                        <a class="@(x.Id == f.Id ? "is-active" : "")" href="/watch/@m.Id?file=@x.Id">@x.FileName</a>
                    }
                </div>
            }
            <p><a href="/movie/@m.Id">← Back to details</a></p>
        </div>
        <script type="application/json" id="player-config">@Html.Raw(Model.ConfigJson)</script>
    }
</div>

@section Scripts {
    @if (f != null) { <script src="~/js/player.js" asp-append-version="true"></script> }
}
