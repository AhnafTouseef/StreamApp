@page "/watch/{id:int}"
@model StreamApp.Pages.Watch.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Watch " + Model.Movie.Title;
    var m = Model.Movie;
    var f = Model.Current;
}
<div class="watch-page">
    @if (f == null)
    {
        <partial name="_EmptyState" model="@("Nothing to play", Site.Current.ViewFor(User.Identity?.IsAuthenticated == true).HideHints ? "No video file is available for this entry right now." : "No video file is recorded for this entry. An administrator can re-scan its source.")" />
        <p style="text-align:center"><a class="btn btn-ghost" href="/movie/@m.Id">Back to details</a></p>
    }
    else
    {
        <div class="player is-paused" id="player" tabindex="0" aria-label="Video player">
            <video id="video" preload="metadata" playsinline></video>
            <div class="subs" id="subs" aria-live="off"></div>
            <div class="player-overlay"><div class="player-spinner"></div></div>
            <div class="drop-hint" aria-hidden="true"><div><strong>Drop subtitle file</strong><span>.srt · .vtt · .ass · .ssa</span></div></div>
            <div class="seek-flash seek-back" id="flash-back" aria-hidden="true"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 6l-6 6 6 6M19 6l-6 6 6 6"/></svg><b>10 s</b></div>
            <div class="seek-flash seek-fwd" id="flash-fwd" aria-hidden="true"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 6l6 6-6 6M5 6l6 6-6 6"/></svg><b>10 s</b></div>
            <div class="hold-badge" id="hold-badge" aria-hidden="true">2× ▶▶</div>
            <div class="player-toast" id="player-toast" role="status"></div>
            <div class="player-message" id="player-message" role="alert"><div><h2 id="msg-title">Playback problem</h2><p id="msg-text"></p><button class="btn btn-primary btn-sm" id="msg-retry" type="button">Try again</button></div></div>

            <div class="tuner" id="tuner" hidden>
                <div class="tuner-head"><strong>Subtitle timing</strong><button type="button" class="tuner-x" id="tuner-close" aria-label="Close timing panel">✕</button></div>
                <div class="tuner-track" id="tuner-track">No subtitle selected</div>
                <div class="tuner-read"><output id="tuner-offset">0.00 s</output></div>
                <div class="tuner-steps">
                    <button type="button" data-step="-1">−1 s</button>
                    <button type="button" data-step="-0.1">−0.1</button>
                    <button type="button" data-step="0.1">+0.1</button>
                    <button type="button" data-step="1">+1 s</button>
                </div>
                <input type="range" id="tuner-slider" min="-60" max="60" step="0.05" value="0" aria-label="Subtitle offset in seconds" />
                <p class="tuner-help hint-only">Minus shows subtitles earlier, plus shows them later. Keys: <kbd>G</kbd> earlier, <kbd>H</kbd> later.</p>
                <button type="button" class="tuner-sync" id="tuner-sync">Sync: the closest line starts right now</button>
                <p class="tuner-help hint-only">Pause exactly when you hear a line begin, then press Sync.</p>
                <label class="tuner-row">Frame-rate fix
                    <select id="tuner-scale" aria-label="Subtitle frame-rate correction">
                        <option value="1">None</option>
                        <option value="0.959040959">23.976 → 25 fps</option>
                        <option value="1.04270937">25 → 23.976 fps</option>
                        <option value="0.96">24 → 25 fps</option>
                        <option value="1.041666667">25 → 24 fps</option>
                        <option value="0.999000999">23.976 → 24 fps</option>
                        <option value="1.001">24 → 23.976 fps</option>
                    </select>
                </label>
                <p class="tuner-help hint-only">Use when the subtitle starts in sync but drifts further out of sync as the movie goes on.</p>
                <div class="tuner-row">Size
                    <span class="tuner-size"><button type="button" id="size-down" aria-label="Smaller subtitles">A−</button><output id="size-read">100%</output><button type="button" id="size-up" aria-label="Larger subtitles">A+</button></span>
                </div>
                <button type="button" class="tuner-reset" id="tuner-reset">Reset timing</button>
            </div>

            <div class="topbar" id="topbar">
                <span class="player-title" id="player-title">@m.Title @(m.ReleaseYear.HasValue ? $"({m.ReleaseYear})" : "")</span>
                <button class="ctrl-btn top-gear js-settings" id="btn-settings-top" type="button" aria-label="Settings" aria-haspopup="dialog" aria-expanded="false" title="Settings"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
            </div>

            <button class="big-play" id="big-play" type="button" aria-label="Play"><svg class="fl" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>

            <div class="controls" id="controls">
                <div class="seek" id="seek-wrap">
                    <div class="seek-track"></div><div class="buffered" id="buffered"></div><div class="played" id="played"></div>
                    <input type="range" id="seek" min="0" max="1000" value="0" step="1" aria-label="Seek" />
                    <div class="seek-tip" id="seek-tip" aria-hidden="true">0:00</div>
                </div>
                <div class="ctrl-row">
                    <button class="ctrl-btn" id="play" type="button" aria-label="Play"><svg class="fl" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
                    <button class="ctrl-btn" id="mute" type="button" aria-label="Mute"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg></button>
                    <input type="range" id="volume" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
                    <span class="time"><span id="t-cur">0:00</span> / <span id="t-dur">0:00</span></span>
                    <span class="spacer"></span>
                    <button class="ctrl-btn" id="btn-sub" type="button" aria-label="Subtitles" title="Subtitles (C)"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10.5 10.2a2.2 2.2 0 1 0 0 3.6M16.5 10.2a2.2 2.2 0 1 0 0 3.6"/></svg></button>
                    <button class="ctrl-btn js-settings" id="btn-settings" type="button" aria-label="Settings" aria-haspopup="dialog" aria-expanded="false" title="Settings"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
                    <button class="ctrl-btn" id="fs" type="button" aria-label="Fullscreen" title="Fullscreen (F)"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
                </div>
            </div>

            <div class="settings-scrim" id="settings-scrim" hidden></div>
            <div class="settings" id="settings" hidden role="dialog" aria-label="Settings">
                <div class="set-head">
                    <button type="button" class="ctrl-btn set-back" id="set-back" aria-label="Back" hidden><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
                    <span class="set-title" id="set-title">Settings</span>
                    <button type="button" class="ctrl-btn set-close" id="set-close" aria-label="Close"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
                </div>
                <div class="set-views">
                    <div class="set-view is-on" id="set-home">
                        <button type="button" class="set-row" id="row-sub" data-view="menu-sub" data-title="Subtitles"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10.5 10.2a2.2 2.2 0 1 0 0 3.6M16.5 10.2a2.2 2.2 0 1 0 0 3.6"/></svg><span class="set-name">Subtitles</span><span class="set-val" id="val-sub">Off</span><svg class="st chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
                        <button type="button" class="set-row" id="btn-audio" data-view="menu-audio" data-title="Audio"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg><span class="set-name">Audio</span><span class="set-val" id="val-audio"></span><svg class="st chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
                        <button type="button" class="set-row" id="btn-speed" data-view="menu-speed" data-title="Playback speed"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 17a8.5 8.5 0 1 1 15 0"/><path d="M12 13l4-4"/></svg><span class="set-name">Playback speed</span><span class="set-val" id="val-speed">1×</span><svg class="st chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
                        <button type="button" class="set-row compat-ui" id="btn-method" data-view="view-method" data-title="Stream method" hidden><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg><span class="set-name">Stream method</span><span class="set-val" id="val-method"></span><svg class="st chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
                        <div class="set-row set-switch compat-ui" id="row-compat">
                            <label class="compat-switch" for="compat-switch"><svg class="st" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/></svg><span class="set-name">Compatibility mode</span><b class="set-val" id="compat-state">Off</b><input type="checkbox" id="compat-switch" role="switch" /><span class="compat-track" aria-hidden="true"></span></label>
                        </div>
                        <div class="set-note muted small tech-only compat-ui" id="compat-hint"></div>
                    </div>
                    <div class="set-view set-list" id="menu-sub" data-title="Subtitles"></div>
                    <div class="set-view set-list" id="menu-audio" data-title="Audio"></div>
                    <div class="set-view set-list menu-speed" id="menu-speed" data-title="Playback speed"></div>
                    <div class="set-view" id="view-method" data-title="Stream method">
                        <div class="speed-row compat-ui" id="speed-row" hidden>
                            <span class="speed-btns" id="speed-btns" role="group" aria-label="Stream method">
                                <button type="button" data-speed="fastest">Fastest</button><button type="button" data-speed="fast">Fast</button><button type="button" data-speed="slow">Slow</button><button type="button" data-speed="slowest">Slowest</button>
                            </span>
                            <span class="set-note muted small hint-only">Start with the fastest. If the picture or the sound is missing, choppy or out of step, try the next one: slower methods make the stream and seeking slower, but work with more files.</span>
                        </div>
                    </div>
                </div>
            </div>
            <input type="file" id="sub-file" accept=".srt,.vtt,.ass,.ssa" hidden />
        </div>

        <div class="watch-info">
            <h1>@m.Title @(m.ReleaseYear.HasValue ? $"({m.ReleaseYear})" : "")</h1>
            <div class="muted tech-only" id="stream-status">Streaming directly from the source server.</div>
            <div class="muted">@f.FileName</div>
            <div class="muted small hint-only" id="sub-tip" hidden>No subtitles found for this movie: drag a subtitle file (.srt, .vtt, .ass) onto the video to use one.</div>
            @if (m.MediaFiles.Count > 1)
            {
                <div class="picker" aria-label="Choose file">
                    @foreach (var x in m.MediaFiles.OrderBy(x => x.FileName))
                    {
                        <a class="@(x.Id == f.Id ? "is-active" : "")" href="/watch/@m.Id?file=@x.Id">@x.FileName</a>
                    }
                </div>
            }
            <p><a href="/movie/@m.Id">← Back to details</a></p>
        </div>
        <script type="application/json" id="player-config">@Html.Raw(Model.ConfigJson)</script>
    }
</div>

@section Scripts {
    @if (f != null) { <script src="~/js/player.js" asp-append-version="true"></script> }
}
