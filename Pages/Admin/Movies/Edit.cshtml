@page "/admin/movies/edit/{id:int}"
@model StreamApp.Pages.Admin.Movies.EditModel
@using System.Globalization
@{
    ViewData["Title"] = "Edit " + Model.Movie.Title; ViewData["Active"] = "movies";
    Layout = Model.Embed ? "_EmbedLayout" : "_AdminLayout";
    var m = Model.Movie;
}
@if (!Model.Embed) { <p><a href="/admin/movies">← All movies</a></p> }
<h1>@m.Title</h1>
<p class="muted">Match: <span class="status @m.MatchStatus">@m.MatchStatus</span> @(m.TmdbId.HasValue ? $"· TMDB #{m.TmdbId}" : "") @(string.IsNullOrEmpty(m.MatchNote) ? "" : "· " + m.MatchNote)</p>

<div class="panel">
    <h3>Source</h3>
    <div class="facts" style="margin:0">
        <span class="muted">Source</span><span>@m.Source.Name</span>
        <span class="muted">Folder</span><span class="mono">@m.FolderName</span>
        <span class="muted">Folder URL</span><span class="mono" style="overflow-wrap:anywhere"><a href="@m.SourceFolderUrl" target="_blank" rel="noopener">@m.SourceFolderUrl</a></span>
        <span class="muted">Discovered</span><span>@m.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC · last seen @m.LastDiscoveredAt.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
    <p class="muted" style="margin-bottom:0">Removing an entry here only removes it from this catalog. Nothing is ever deleted on the ISP server.</p>
</div>

<div class="panel">
    <h3>TMDB match</h3>
    <form method="post" asp-page-handler="SearchTmdb" class="filters" style="border:0;padding:0;background:none;margin:0 0 12px">
        <input type="search" name="searchTitle" value="@Model.SearchTitle" placeholder="Title to search on TMDB" />
        <input type="search" name="searchYear" value="@Model.SearchYear" placeholder="Year" style="flex:0 0 100px" />
        <button class="btn btn-primary btn-sm" type="submit">Search TMDB</button>
    </form>
    @if (Model.Candidates != null)
    {
        if (Model.Candidates.Count == 0) { <p class="muted">No TMDB results.</p> }
        else
        {
            <ul class="source-list">
                @foreach (var c in Model.Candidates)
                {
                    <li>
                        <div class="grow"><span class="name">@c.Title @(c.Year.HasValue ? $"({c.Year})" : "") <small class="muted">#@c.Id</small></span><span class="specs">@(c.Overview is { Length: > 160 } o ? o[..160] + "…" : c.Overview)</span></div>
                        <form method="post" asp-page-handler="ApplyTmdb" asp-route-id="@m.Id" asp-route-tmdbId="@c.Id" class="inline"><button class="btn btn-primary btn-sm" type="submit">Use this match</button></form>
                    </li>
                }
            </ul>
        }
    }
    <form method="post" asp-page-handler="ApplyTmdb" asp-route-id="@m.Id" class="actions" style="margin-top:12px">
        <input name="tmdbId" type="number" min="1" placeholder="…or enter a TMDB id" style="padding:7px 10px;border-radius:8px;border:1px solid var(--line);background:var(--bg)" />
        <button class="btn btn-ghost btn-sm" type="submit">Apply id</button>
        @if (m.TmdbId.HasValue)
        {
            <button class="btn btn-ghost btn-sm" type="submit" asp-page-handler="Refetch" asp-route-id="@m.Id" formnovalidate>Re-fetch metadata</button>
            <button class="btn btn-danger btn-sm" type="submit" asp-page-handler="ClearMatch" asp-route-id="@m.Id" formnovalidate onclick="return confirm('Remove the TMDB association? The entry itself stays.')">Remove match</button>
        }
    </form>
</div>

<form method="post" asp-page-handler="Save" class="panel">
    <div asp-validation-summary="All" class="alert err"></div>
    <h3>Metadata</h3>
    <div class="form-grid">
        <div class="field"><label asp-for="Input.Title">Title</label><input asp-for="Input.Title" required maxlength="400" /></div>
        <div class="field"><label asp-for="Input.OriginalTitle">Original title</label><input asp-for="Input.OriginalTitle" maxlength="400" /></div>
        <div class="field"><label asp-for="Input.ReleaseYear">Release year</label><input asp-for="Input.ReleaseYear" type="number" min="1880" max="2100" /></div>
        <div class="field"><label asp-for="Input.Runtime">Runtime (minutes)</label><input asp-for="Input.Runtime" type="number" min="0" /></div>
        <div class="field"><label asp-for="Input.CategoryId">Category</label><select asp-for="Input.CategoryId">@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select></div>
        <div class="field"><label asp-for="Input.ImdbRating">IMDb rating</label><input asp-for="Input.ImdbRating" type="number" step="0.1" min="0" max="10" /></div>
        <div class="field wide"><label asp-for="Input.PosterUrl">Poster URL</label><input asp-for="Input.PosterUrl" /><span class="hint">Any image URL. Clear it to fall back to the placeholder.</span></div>
        <div class="field wide"><label asp-for="Input.BackdropUrl">Backdrop URL</label><input asp-for="Input.BackdropUrl" /></div>
        <div class="field wide"><label asp-for="Input.Overview">Overview</label><textarea asp-for="Input.Overview"></textarea></div>
    </div>
    <div class="actions" style="margin-top:14px"><button class="btn btn-primary" type="submit">Save</button></div>
</form>

<div class="panel">
    <h3>Media files (@m.MediaFiles.Count)</h3>
    @foreach (var f in m.MediaFiles.OrderBy(f => f.FileName))
    {
        <details class="panel" style="margin:8px 0">
            <summary>@f.FileName <span class="muted">· @string.Join(" · ", new[] { f.Resolution, f.VideoCodec, f.AudioCodec, f.Duration.HasValue ? TimeSpan.FromSeconds(f.Duration.Value).ToString(@"h\:mm\:ss") : null }.Where(s => !string.IsNullOrEmpty(s)))</span>
                @if (!string.IsNullOrEmpty(f.InspectionError)) { <span class="status Failed">ffprobe error</span> }</summary>
            <p class="mono" style="overflow-wrap:anywhere"><a href="@f.FileUrl" target="_blank" rel="noopener">@f.FileUrl</a></p>
            @if (!string.IsNullOrEmpty(f.InspectionError)) { <p class="alert err">@f.InspectionError</p> }
            <div class="table-wrap"><table class="data">
                <thead><tr><th>#</th><th>Type</th><th>Codec</th><th>Language</th><th>Title</th><th>Default</th></tr></thead>
                <tbody>
                @foreach (var s in f.Streams.OrderBy(s => s.StreamIndex))
                {
                    <tr><td>@s.StreamIndex</td><td>@s.StreamType</td><td>@s.Codec</td><td>@(s.Language ?? "—")</td><td>@s.Title</td><td>@(s.IsDefault ? "yes" : "")</td></tr>
                }
                @if (f.Streams.Count == 0) { <tr><td colspan="6" class="muted">No stream data stored.</td></tr> }
                </tbody>
            </table></div>
            <p><button class="btn btn-ghost btn-sm" type="button" data-probe="@f.Id">Check server (range / CORS)</button> <span class="mono muted" id="probe-@f.Id"></span></p>
        </details>
    }
    <form method="post" asp-page-handler="Reinspect" asp-route-id="@m.Id"><button class="btn btn-ghost btn-sm" type="submit">Re-run ffprobe on all files</button></form>
    @if (m.Subtitles.Count > 0)
    {
        <h3 style="margin-top:16px">Subtitles</h3>
        <ul class="source-list">@foreach (var s in m.Subtitles) { <li><span class="grow name">@s.FileName</span><span class="specs">@(s.Language ?? "unknown") · @s.Format</span></li> }</ul>
    }
</div>

<form method="post" asp-page-handler="Delete" asp-route-id="@m.Id" onsubmit="return confirm('Remove this entry from the catalog? Files on the ISP server are not touched.')">
    <button class="btn btn-danger" type="submit">Remove this catalog entry</button>
</form>

<script>
document.querySelectorAll('[data-probe]').forEach(function (b) {
  b.addEventListener('click', async function () {
    var out = document.getElementById('probe-' + b.dataset.probe);
    out.textContent = 'checking…';
    try {
      var r = await fetch('/media/probe/' + b.dataset.probe);
      var j = await r.json();
      out.textContent = j.error ? 'ERROR: ' + j.error :
        'HTTP ' + j.statusCode + ' · ranges: ' + (j.supportsRanges ? 'yes' : 'NO') + ' · type: ' + (j.contentType || '?') + ' · CORS header: ' + (j.corsAllowOrigin || 'none');
    } catch (e) { out.textContent = 'request failed'; }
  });
});
</script>
