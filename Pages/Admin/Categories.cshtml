@page "/admin/categories"
@model MovieHub.Pages.Admin.CategoriesModel
@{ ViewData["Title"] = "Categories"; ViewData["Active"] = "categories"; var e = Model.Input; }
<div class="page-head"><h1>Categories</h1><button class="btn btn-primary" type="button" data-open="form-dialog">+ Add category</button></div>
<p class="muted">Active categories appear in the site navigation and get their own page at <code>/movies/&lt;slug&gt;</code> immediately. No code change is needed.</p>

<dialog id="form-dialog" class="modal" data-return="/admin/categories" @(Model.ShowForm ? "open" : null) @(Model.ShowForm ? "data-autoopen" : null)>
    <form method="post" asp-page-handler="Save" class="modal-form">
        <div class="modal-head">
            <h3>@(e.Id == 0 ? "New category" : "Edit category")</h3>
            <button type="button" class="modal-x" data-close aria-label="Close">×</button>
        </div>
        <div class="modal-body">
            <div asp-validation-summary="All" class="alert err"></div>
            <input type="hidden" asp-for="Input.Id" />
            <div class="form-grid">
        <div class="field"><label asp-for="Input.Name">Name</label><input asp-for="Input.Name" required maxlength="120" /></div>
        <div class="field"><label asp-for="Input.Slug">Slug (URL)</label><input asp-for="Input.Slug" maxlength="120" placeholder="generated from the name" /><span class="hint">Lowercase letters, digits and dashes.</span></div>
        <div class="field"><label asp-for="Input.ParentCategoryId">Parent category</label>
            <select asp-for="Input.ParentCategoryId">
                <option value="">— none (top level) —</option>
                @foreach (var c in Model.All.Where(c => c.Id != e.Id)) { <option value="@c.Id">@c.Name</option> }
            </select></div>
        <div class="field"><label asp-for="Input.DisplayOrder">Display order</label><input asp-for="Input.DisplayOrder" type="number" /></div>
        <div class="field wide"><label asp-for="Input.Description">Description</label><textarea asp-for="Input.Description" maxlength="500"></textarea></div>
        <div class="field"><label><input type="checkbox" asp-for="Input.IsActive" /> Active (shown on the site)</label></div>
    </div>
        </div>
        <div class="modal-foot">
            <button class="btn btn-ghost" type="button" data-close>Cancel</button>
            <button class="btn btn-primary" type="submit">@(e.Id == 0 ? "Create category" : "Save changes")</button>
        </div>
    </form>
</dialog>

<div class="table-wrap"><table class="data">
    <thead><tr><th>Name</th><th>Slug</th><th>Parent</th><th>Order</th><th>Movies</th><th>Sources</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Rows)
    {
        <tr>
            <td>@c.Name</td><td><a href="/movies/@c.Slug" target="_blank" rel="noopener"><code>@c.Slug</code></a></td><td>@c.ParentName</td><td>@c.DisplayOrder</td>
            <td>@c.MovieCount</td><td>@c.SourceCount</td>
            <td><span class="status @(c.IsActive ? "Succeeded" : "Failed")">@(c.IsActive ? "Active" : "Hidden")</span></td>
            <td class="actions">
                <a class="btn btn-ghost btn-sm" href="/admin/categories?edit=@c.Id">Edit</a>
                <form method="post" asp-page-handler="Toggle" asp-route-id="@c.Id" class="inline"><button class="btn btn-ghost btn-sm" type="submit">@(c.IsActive ? "Hide" : "Show")</button></form>
                <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="inline" onsubmit="return confirm('Delete this category?')"><button class="btn btn-danger btn-sm" type="submit">Delete</button></form>
            </td>
        </tr>
    }
    </tbody>
</table></div>
