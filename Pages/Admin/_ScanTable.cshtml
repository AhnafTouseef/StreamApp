@model IReadOnlyList<MovieHub.Pages.Admin.ScanRow>
<div class="table-wrap"><table class="data">
    <thead><tr><th>Source</th><th>Started (UTC)</th><th>Duration</th><th>Status</th><th>Found</th><th>New</th><th>Updated</th><th>Failed</th><th>Trigger</th><th>Error</th></tr></thead>
    <tbody>
    @foreach (var h in Model)
    {
        <tr>
            <td>@h.SourceName</td>
            <td>@h.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@(h.FinishedAt.HasValue ? ((int)(h.FinishedAt.Value - h.StartedAt).TotalSeconds) + " s" : "—")</td>
            <td><span class="status @h.Status">@h.Status</span>@(h.Deep ? " (deep)" : "")</td>
            <td>@h.DiscoveredCount</td><td>@h.AddedCount</td><td>@h.UpdatedCount</td><td>@h.FailedCount</td>
            <td>@h.Trigger</td>
            <td class="muted">@h.ErrorMessage</td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="10" class="muted">None.</td></tr> }
    </tbody>
</table></div>
