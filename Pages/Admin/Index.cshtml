@page "/admin"
@model StreamApp.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Dashboard"; ViewData["Active"] = "dashboard"; if (Model.AnyRunning) { ViewData["Refresh"] = 8; } }
<h1>Dashboard</h1>
<div class="stat-grid">
    <div class="stat"><b>@Model.TotalMovies.ToString("N0")</b><span>Movie entries</span></div>
    <div class="stat"><b>@Model.TotalCategories</b><span>Categories</span></div>
    <div class="stat"><b>@Model.TotalSources</b><span>Registered sources</span></div>
    <div class="stat"><b>@(Model.LastSuccess?.ToString("yyyy-MM-dd HH:mm") ?? "never")</b><span>Last successful scan (UTC)</span></div>
</div>
@if (Model.AnyRunning) { <p class="notice is-live">A scan is running. This page refreshes automatically.</p> }

<h2>Media tools</h2>
<div class="table-wrap"><table class="data">
    <tbody>
        <tr><td><strong>FFprobe</strong><br /><span class="muted">reads audio tracks, codecs, duration</span></td>
            <td><span class="status @(Model.FfprobeOk ? "Succeeded" : "Failed")">@(Model.FfprobeOk ? "Found" : "Missing")</span> <span class="mono muted">@Model.FfprobeInfo</span></td></tr>
        <tr><td><strong>FFmpeg</strong><br /><span class="muted">audio switching, MKV/HEVC/AC3 playback</span></td>
            <td><span class="status @(Model.FfmpegOk ? "Succeeded" : "Failed")">@(Model.FfmpegOk ? "Found" : "Missing")</span> <span class="mono muted">@Model.FfmpegInfo</span></td></tr>
        <tr><td><strong>Files without stream info</strong><br /><span class="muted">no audio list in the player until inspected</span></td>
            <td>
                @if (Model.Backfill.IsRunning) { <span class="status Running">Inspecting @Model.Backfill.Done / @Model.Backfill.Total</span> @if (Model.Backfill.Failed > 0) { <span class="muted"> · @Model.Backfill.Failed failed</span> } }
                else
                {
                    <strong>@Model.PendingInspections.ToString("N0")</strong>
                    <form method="post" asp-page-handler="InspectPending" class="inline"><button class="btn btn-primary btn-sm" type="submit" disabled="@(Model.PendingInspections == 0 || !Model.FfprobeOk)">Inspect them now</button></form>
                }
            </td></tr>
        <tr><td><strong>Posters from the ISP folder</strong><br /><span class="muted">TMDB posters are used for matched movies; the folder poster is only the fallback</span></td>
            <td>
                @if (Model.Posters.IsRunning) { <span class="status Running">Switching @Model.Posters.Done.ToString("N0") / @Model.Posters.Total.ToString("N0")</span> }
                else
                {
                    <strong>@Model.FolderPosterCount.ToString("N0")</strong>
                    <form method="post" asp-page-handler="UseTmdbPosters" class="inline"><button class="btn btn-primary btn-sm" type="submit" disabled="@(Model.FolderPosterCount == 0 || !Model.TmdbOk)">Use TMDB posters</button></form>
                    @if (Model.Posters.FinishedAt != null)
                    {
                        <span class="muted"> · last run: @Model.Posters.Switched.ToString("N0") switched@(Model.Posters.Kept > 0 ? $", {Model.Posters.Kept:N0} have no TMDB poster (they keep the folder poster)" : "")@(Model.Posters.Failed > 0 ? $", {Model.Posters.Failed:N0} failed ({Model.Posters.LastError})" : "")</span>
                    }
                }
            </td></tr>
    </tbody>
</table></div>
@if (Model.Installer.IsRunning)
{
    <p class="notice">FFmpeg download: <strong>@Model.Installer.Status</strong></p>
}
else if (!string.IsNullOrEmpty(Model.Installer.LastError))
{
    <p class="notice notice-error">FFmpeg download failed: @Model.Installer.LastError</p>
}
@if (!Model.FfprobeOk || !Model.FfmpegOk)
{
    <div class="notice">
        <p style="margin-top:0">FFmpeg is kept <strong>inside the project</strong> so the whole folder can be moved to another computer: <code>@Model.Installer.TargetDirectory</code></p>
        <form method="post" asp-page-handler="DownloadFfmpeg" class="inline">
            <button class="btn btn-primary btn-sm" type="submit" disabled="@(!Model.Installer.CanInstall || Model.Installer.IsRunning)">Download FFmpeg into the project</button>
        </form>
        <form method="post" asp-page-handler="RecheckTools" class="inline"><button class="btn btn-sm" type="submit">Check again</button></form>
        <p class="muted" style="margin-bottom:0">Or copy <code>ffmpeg</code> and <code>ffprobe</code> into that folder yourself, then press “Check again” (no restart needed).</p>
    </div>
}

<h2>Recently discovered movies</h2>
<div class="table-wrap"><table class="data">
    <thead><tr><th>Title</th><th>Year</th><th>Source</th><th>Match</th><th>Added (UTC)</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Recent)
    {
        <tr><td><a href="/admin/movies/edit/@m.Id">@m.Title</a></td><td>@m.ReleaseYear</td><td>@m.SourceName</td><td><span class="status @m.MatchStatus">@m.MatchStatus</span></td><td>@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
    }
    @if (Model.Recent.Count == 0) { <tr><td colspan="5" class="muted">Nothing indexed yet. Open <a href="/admin/scans">Scans</a> and start a scan.</td></tr> }
    </tbody>
</table></div>

<h2 style="margin-top:28px">Recent scans</h2>
<partial name="_ScanTable" model="Model.History" />

<h2 style="margin-top:28px">Scan failures</h2>
<partial name="_ScanTable" model="Model.Failures" />
