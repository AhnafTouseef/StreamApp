@page "/Error"
@model StreamApp.Pages.ErrorModel
@{ ViewData["Title"] = Model.Code == 404 ? "Not found" : "Error"; }
<div class="page">
    <partial name="_EmptyState" model="@(Model.Code == 404 ? "Page not found" : "Something went wrong", Model.Code == 404 ? "The page or movie you asked for does not exist (any more)." : "The request could not be completed. The error has been logged.")" />
    <p style="text-align:center"><a class="btn btn-primary" href="/">Back to home</a></p>
</div>
