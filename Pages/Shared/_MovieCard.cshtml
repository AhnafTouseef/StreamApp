@model MovieCardDto
@{
    var selectable = ViewData["Selectable"] as bool? ?? false;
    var genres = string.Join(", ", Model.Genres);
    var rating = Model.Rating?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    var sub = (Model.Year?.ToString() ?? "—") + (rating != null ? " · ★ " + rating : "");
    // Cards on the home page's first row carry the data the banner needs; every other card has no data-feature attribute at all
    // (Razor renders data-x="" for a null value instead of omitting it, so the attributes are written out explicitly).
    string Attr(string name, string? v) => name + "=\"" + System.Text.Encodings.Web.HtmlEncoder.Default.Encode(v ?? "") + "\"";
    var featureAttrs = selectable
        ? new Microsoft.AspNetCore.Html.HtmlString(string.Join(" ", new[]
        {
            Attr("data-feature", Model.Id.ToString()), Attr("data-title", Model.Title), Attr("data-year", Model.Year?.ToString()),
            Attr("data-rating", rating), Attr("data-genres", genres), Attr("data-overview", Model.Overview),
            Attr("data-backdrop", Model.BackdropUrl ?? Model.PosterUrl)
        }))
        : Microsoft.AspNetCore.Html.HtmlString.Empty;
}
<a class="card" href="@(Model.IsSeries ? "/series/" + Model.Id : "/movie/" + Model.Id)" title="@Model.Title" @featureAttrs>
    <div class="card-poster">
        <img src="@(Model.PosterUrl ?? "/images/poster-fallback.svg")" alt="@Model.Title poster" loading="lazy" width="300" height="450"
             onerror="this.onerror=null;this.src='/images/poster-fallback.svg'" />
        @if (Model.IsSeries)
        {
            <span class="badge-quality">SERIES</span>
        }
        else if (!string.IsNullOrEmpty(Model.Quality))
        {
            <span class="badge-quality">@Model.Quality</span>
        }
        <div class="card-hover">
            <strong>@Model.Title</strong>
            <span>@sub</span>
            @if (genres.Length > 0) { <small>@genres</small> }
            <span class="card-actions"><span class="card-go" data-href="/watch/@Model.Id">▶ Watch</span></span>
        </div>
    </div>
    <div class="card-meta">
        <span class="card-title">@Model.Title</span>
        <span class="card-sub">@sub</span>
    </div>
</a>
